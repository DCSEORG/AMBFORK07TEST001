@page
@model ExpenseManagement.Pages.ChatModel
@{
    ViewData["Title"] = "AI Chat Assistant";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">
                    <i class="bi bi-robot me-2"></i>
                    AI Expense Assistant
                </h4>
            </div>
            <div class="card-body" style="height: 500px; overflow-y: auto;" id="chatMessages">
                @if (!Model.GenAIConfigured)
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>GenAI Not Configured</strong>
                        <p class="mb-0 mt-2">
                            The AI chat feature requires Azure OpenAI to be deployed. 
                            To enable this feature, redeploy your infrastructure with the <code>-DeployGenAI</code> switch:
                        </p>
                        <pre class="mt-2 mb-0"><code>.\deploy-infra\deploy.ps1 -ResourceGroup "rg-name" -Location "uksouth" -DeployGenAI</code></pre>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-chat-left-text fs-1"></i>
                        <p class="mt-3">Start a conversation! Ask me about your expenses.</p>
                        <small>Try: "Show me all pending expenses" or "Create a new expense for £50 for lunch"</small>
                    </div>
                }
            </div>
            <div class="card-footer">
                <div class="input-group">
                    <input type="text" class="form-control" id="userMessage" placeholder="Ask me about expenses..." @(!Model.GenAIConfigured ? "disabled" : "")>
                    <button class="btn btn-primary" type="button" id="sendButton" @(!Model.GenAIConfigured ? "disabled" : "")>
                        <i class="bi bi-send"></i>
                        Send
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const chatMessages = document.getElementById('chatMessages');
        const userMessage = document.getElementById('userMessage');
        const sendButton = document.getElementById('sendButton');
        let conversationHistory = [];

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function formatMessage(text) {
            // First escape HTML to prevent XSS
            let formatted = escapeHtml(text);
            
            // Then apply markdown-style formatting
            // Bold text
            formatted = formatted.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
            
            // Line breaks
            formatted = formatted.replace(/\n/g, '<br>');
            
            // Ordered lists
            formatted = formatted.replace(/^(\d+\.\s.+)$/gm, function(match) {
                return '<li>' + match.substring(match.indexOf('.') + 1).trim() + '</li>';
            });
            
            // Wrap consecutive list items in ol
            formatted = formatted.replace(/(<li>.*?<\/li>\s*)+/g, function(match) {
                return '<ol>' + match + '</ol>';
            });
            
            // Bullet lists
            formatted = formatted.replace(/^[-*]\s(.+)$/gm, '<li>$1</li>');
            
            // Wrap consecutive bullet items in ul
            formatted = formatted.replace(/(<li>.*?<\/li>\s*(?!<\/ol>))+/g, function(match) {
                // Don't wrap if already wrapped in ol
                if (match.includes('<ol>')) return match;
                return '<ul>' + match + '</ul>';
            });
            
            return formatted;
        }

        function addMessage(role, content, isLoading = false) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `d-flex mb-3 ${role === 'user' ? 'justify-content-end' : ''}`;
            
            const bubble = document.createElement('div');
            bubble.className = `p-3 rounded ${role === 'user' ? 'bg-primary text-white' : 'bg-light'}`;
            bubble.style.maxWidth = '80%';
            
            if (isLoading) {
                bubble.innerHTML = '<div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden">Loading...</span></div>';
            } else {
                if (role === 'assistant') {
                    bubble.innerHTML = formatMessage(content);
                } else {
                    bubble.textContent = content;
                }
            }
            
            messageDiv.appendChild(bubble);
            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
            
            return messageDiv;
        }

        async function sendMessage() {
            const message = userMessage.value.trim();
            if (!message) return;

            // Add user message to UI
            addMessage('user', message);
            
            // Add to history
            conversationHistory.push({ role: 'user', content: message });

            // Clear input
            userMessage.value = '';
            sendButton.disabled = true;

            // Show loading indicator
            const loadingDiv = addMessage('assistant', '', true);

            try {
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        message: message,
                        history: conversationHistory
                    })
                });

                const data = await response.json();

                // Remove loading indicator
                loadingDiv.remove();

                if (data.success) {
                    // Add assistant response
                    addMessage('assistant', data.response);
                    
                    // Add to history
                    conversationHistory.push({ role: 'assistant', content: data.response });
                } else {
                    addMessage('assistant', data.error || 'An error occurred while processing your request.');
                }
            } catch (error) {
                loadingDiv.remove();
                addMessage('assistant', 'Sorry, I encountered an error. Please try again.');
                console.error('Error:', error);
            } finally {
                sendButton.disabled = false;
                userMessage.focus();
            }
        }

        sendButton.addEventListener('click', sendMessage);
        userMessage.addEventListener('keypress', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        // Focus on input if enabled
        if (!sendButton.disabled) {
            userMessage.focus();
        }
    </script>
}
