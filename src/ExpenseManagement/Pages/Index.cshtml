@page
@model ExpenseManagement.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="row mb-4">
    <div class="col">
        <h1 class="display-5 mb-3">
            <i class="bi bi-receipt text-primary"></i>
            Expense Management Dashboard
        </h1>
        <p class="lead text-muted">
            Manage your expenses efficiently with our modern expense tracking system.
        </p>
    </div>
</div>

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="bi bi-file-earmark-text text-primary fs-1"></i>
                <h3 class="mt-2">@Model.Expenses.Count</h3>
                <p class="text-muted mb-0">Total Expenses</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="bi bi-hourglass-split text-warning fs-1"></i>
                <h3 class="mt-2">@Model.Expenses.Count(e => e.StatusName == "Pending")</h3>
                <p class="text-muted mb-0">Pending Approval</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="bi bi-check-circle text-success fs-1"></i>
                <h3 class="mt-2">@Model.Expenses.Count(e => e.StatusName == "Approved")</h3>
                <p class="text-muted mb-0">Approved</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">
                <i class="bi bi-currency-pound text-info fs-1"></i>
                <h3 class="mt-2">£@Model.Expenses.Where(e => e.StatusName == "Approved").Sum(e => e.Amount).ToString("N2")</h3>
                <p class="text-muted mb-0">Total Approved</p>
            </div>
        </div>
    </div>
</div>

<!-- Recent Expenses -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-list-ul me-2"></i>
                        Recent Expenses
                    </h5>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
                        <i class="bi bi-plus-circle me-1"></i>
                        Add Expense
                    </button>
                </div>
            </div>
            <div class="card-body">
                @if (Model.Expenses.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th>Category</th>
                                    <th>User</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var expense in Model.Expenses.OrderByDescending(e => e.ExpenseDate).Take(10))
                                {
                                    <tr>
                                        <td>@expense.ExpenseDate.ToString("dd MMM yyyy")</td>
                                        <td>@expense.Description</td>
                                        <td>
                                            <span class="badge bg-secondary">@expense.CategoryName</span>
                                        </td>
                                        <td>@expense.UserName</td>
                                        <td class="fw-bold">£@expense.Amount.ToString("N2")</td>
                                        <td>
                                            @if (expense.StatusName == "Pending")
                                            {
                                                <span class="status-badge status-pending">
                                                    <i class="bi bi-hourglass-split me-1"></i>
                                                    Pending
                                                </span>
                                            }
                                            else if (expense.StatusName == "Approved")
                                            {
                                                <span class="status-badge status-approved">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Approved
                                                </span>
                                            }
                                            else if (expense.StatusName == "Rejected")
                                            {
                                                <span class="status-badge status-rejected">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    Rejected
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox fs-1 text-muted"></i>
                        <p class="text-muted mt-3">No expenses found. Click "Add Expense" to get started.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Expense Summary by Category -->
@if (Model.CategorySummary.Any())
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="bi bi-pie-chart me-2"></i>
                        Expenses by Category
                    </h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Count</th>
                                    <th>Total Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var summary in Model.CategorySummary)
                                {
                                    <tr>
                                        <td>@summary.CategoryName</td>
                                        <td>@summary.ExpenseCount</td>
                                        <td class="fw-bold">£@summary.TotalAmount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Quick Actions -->
<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <i class="bi bi-file-earmark-plus text-primary fs-1"></i>
                <h5 class="mt-3">Submit Expense</h5>
                <p class="text-muted">Create and submit a new expense for approval</p>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
                    Get Started
                </button>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <i class="bi bi-graph-up text-success fs-1"></i>
                <h5 class="mt-3">View Reports</h5>
                <p class="text-muted">Analyze spending patterns and trends</p>
                <a href="/api/expenses" class="btn btn-outline-success">View API</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <i class="bi bi-robot text-info fs-1"></i>
                <h5 class="mt-3">AI Assistant</h5>
                <p class="text-muted">Ask questions about your expenses using AI</p>
                <a href="/Chat" class="btn btn-outline-info">Open Chat</a>
            </div>
        </div>
    </div>
</div>

<!-- Add Expense Modal (placeholder) -->
<div class="modal fade" id="addExpenseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Expense</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Use the API endpoints at <a href="/swagger">/swagger</a> to create expenses programmatically.</p>
                <p class="text-muted">Or use the AI Chat assistant to add expenses using natural language.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a href="/swagger" class="btn btn-primary">View API Docs</a>
            </div>
        </div>
    </div>
</div>
